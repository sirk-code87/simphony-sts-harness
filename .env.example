# Copy to .env and fill in. .env is gitignored; never commit it.
# Mock mode needs none of these. Live mode needs all of the first five.

# Auth host, e.g. https://<your-sts-auth-host>  (no trailing slash, no path)
STS_AUTH_HOST=
# API host, e.g. https://<your-sts-api-host>  (paths /api/v1/... are appended)
STS_API_HOST=
STS_CLIENT_ID=
STS_USERNAME=
STS_PASSWORD=

# Defaults that prefill the Context step (optional)
STS_ORG_SHORT_NAME=
STS_LOC_REF=
STS_RVC_REF=
STS_EMPLOYEE_REF=
STS_ORDER_TYPE_REF=

# Local port (binds to 127.0.0.1 only)
PORT=4870
